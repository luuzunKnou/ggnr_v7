# road_gyeongsan (경산도로) - 프로젝트별 설정
# [dev] 개발 / [demo] 시연 / [prod] 운영

[dev]
DATABASE_HOST=192.168.127.32
DATABASE_PORT=5433
DATABASE_NAME=road_gyeongsan
DATABASE_USER=road_gyeongsan
DATABASE_PASSWORD=road_gyeongsan
GGNR_PIPELINE_PYTHON=python/env/python.exe
GGNR_DATA_DIR=g:\ggnr_data_dir\road_gyeongsan

[demo]
PORT=80
DATABASE_HOST=
DATABASE_PORT=5433
DATABASE_NAME=road_gyeongsan
DATABASE_USER=road_gyeongsan
DATABASE_PASSWORD=road_gyeongsan
GGNR_PIPELINE_PYTHON=python/env/python.exe
GGNR_DATA_DIR=g:\ggnr_data_dir\road_gyeongsan
# 게이트 https://dggskorea/road_gyeongsan
