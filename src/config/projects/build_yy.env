# [dev] 개발 / [demo] 시연 / [prod] 운영
# BASE_PATH — 게이트 https://dggskorea/[프로젝트명] (예: /build_yy). 빌드·기동 동일 값. 없으면 루트(IP·localhost)
# Next basePath 에는 끝 / 없음 (/build_yy). 게이트 URL 끝이 / 여도 프록시가 /build_yy 로 넘기면 됨.

[dev]
DATABASE_HOST=192.168.127.32
DATABASE_PORT=5433
DATABASE_NAME=build_yy
DATABASE_USER=build_yy
DATABASE_PASSWORD=build_yy
GGNR_PIPELINE_PYTHON=python/env/python.exe
GGNR_DATA_DIR=g:\ggnr_data_dir\build_yy
# 로컬에서 /build_yy 경로 검증 시 주석 해제 (루트 localhost 접속은 막힘)
# BASE_PATH=/build_yy

[demo]
DATABASE_HOST=192.168.126.55
DATABASE_PORT=5432
DATABASE_NAME=build_yy
DATABASE_USER=build_yy
DATABASE_PASSWORD=build_yy
GGNR_PIPELINE_PYTHON=python/env/python.exe
GGNR_DATA_DIR=g:\ggnr_data_dir\build_yy
# 게이트 https://dggskorea/build_yy
BASE_PATH=/build_yy

[prod]
DATABASE_HOST=111.14.1.207
DATABASE_PORT=5433
DATABASE_NAME=build_yy
DATABASE_USER=build_yy
DATABASE_PASSWORD=build_yy
GGNR_PIPELINE_PYTHON=python/env/python.exe
GGNR_DATA_DIR=c:\ggnr_data_dir\build_yy
BASE_PATH=/build_yy
