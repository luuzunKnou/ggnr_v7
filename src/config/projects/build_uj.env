# build_uj (울진건설) - 프로젝트별 설정
# [dev] 개발 / [demo] 시연 / [prod] 운영

[dev]
DATABASE_HOST=192.168.127.32
DATABASE_PORT=5433
DATABASE_NAME=build_uj
DATABASE_USER=build_uj
DATABASE_PASSWORD=build_uj
GGNR_PIPELINE_PYTHON=python/env/python.exe
GGNR_DATA_DIR=g:\ggnr_data_dir\build_uj

[demo]
PORT=80
DATABASE_HOST=192.168.126.59
DATABASE_PORT=5433
DATABASE_NAME=build_uj
DATABASE_USER=build_uj
DATABASE_PASSWORD=build_uj
GGNR_PIPELINE_PYTHON=python/env/python.exe
GGNR_DATA_DIR=g:\ggnr_data_dir\build_uj
# 게이트 https://dggs.kr/build_uj
BASE_PATH=/build_uj
# windows 서비스 등록시 G 드라이브용 권한 필요
NSSM_OBJECT_NAME=.\administrator
NSSM_OBJECT_PASS=Windows2019

[prod]
DATABASE_HOST=111.22.1.83
DATABASE_PORT=5433
