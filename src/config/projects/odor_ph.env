# odor_ph (포항 악취) - 프로젝트별 설정
# [dev] 개발 / [demo] 시연 / [prod] 운영

[dev]
DATABASE_HOST=192.168.127.32
DATABASE_PORT=5433
DATABASE_NAME=odor_ph
DATABASE_USER=odor_ph
DATABASE_PASSWORD=odor_ph
GGNR_PIPELINE_PYTHON=python/env/python.exe
GGNR_DATA_DIR=g:\ggnr_data_dir\odor_ph
# BASE_PATH=/odor_ph

[demo]
PORT=80
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=odor_ph
DATABASE_USER=odor_ph
DATABASE_PASSWORD=odor_ph
GGNR_PIPELINE_PYTHON=python/env/python.exe
GGNR_DATA_DIR=g:\ggnr_data_dir\odor_ph
BASE_PATH=/odor_ph

[prod]
PORT=80
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=odor_ph
DATABASE_USER=odor_ph
DATABASE_PASSWORD=odor_ph
GGNR_PIPELINE_PYTHON=python/env/python.exe
GGNR_DATA_DIR=c:\ggnr_data_dir\odor_ph
