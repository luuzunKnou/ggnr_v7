# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# geoserver_modules (바이너리 파일 포함)
/geoserver_modules/java/
/geoserver_modules/geoserver/

# data_dir는 Git 관리 대상. 아래 런타임 생성 폴더만 제외
/geoserver_modules/data_dir/logs/
/geoserver_modules/data_dir/gwc/

# pg_map_modules (바이너리 파일 포함)
/pg_map_modules/services/pg_tileserv/
/pg_map_modules/services/pg_featureserv/
/pg_map_modules/services/*.zip
/pg_map_modules/services/*.exe

# defineLayer config files (분할된 설정 파일들)
/src/config/defineLayer/
/src/config/defineLayer.config
/src/config/defineLayer.config.backup
