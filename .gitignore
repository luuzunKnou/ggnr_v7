# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# CAD 미리보기 작업 파일 (roadDocCadPreviewPng)
/.cad-preview-work/

# misc
.DS_Store
*.pem
.cursor/local/
.cursor/plans/
.cursor/rules/_personal/
.cursor/debug*.log

# 기동 명령(boot)·버전관리 재시작 신호 (npm run 시 자동 생성, PC/세션마다 다름)
.cursor-runtime/

# local scratch / agent temp
.tmp/
debug-*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# geoserver_modules (바이너리·런타임 번들)
/geoserver_modules/java/
/geoserver_modules/geoserver/
/geoserver_modules.zip

# data_dir 설정은 Git 관리. 런타임 생성 폴더만 제외
/geoserver_modules/data_dir/logs/
/geoserver_modules/data_dir/gwc/

# QCAD / Blender 런타임 모듈
/QCAD_modules/
/modules_blender/

# Node 런타임 번들 (소스 저장소에 포함하지 않음)
/runtime/node/

# 3D 샘플·타일 데이터 (대용량)
/3d_data_dir/

# 도로 문서 원본 (업로드/API로 관리, Git 제외)
/src/app/(pages)/map/_mapContents/road/roadDoc/cad/
/src/app/(pages)/map/_mapContents/road/roadDoc/file/

# pg_map_modules (바이너리 파일 포함)
/pg_map_modules/services/pg_tileserv/
/pg_map_modules/services/pg_featureserv/
/pg_map_modules/services/*.zip
/pg_map_modules/services/*.exe

# defineLayer 백업 파일만 제외 (분할 설정은 Git 관리)
/src/config/defineLayer.config.backup
/src/config/defineLayer/_backup*/

# LAS 파이프라인 Conda 환경 (python/env)
/python/env/

# PaddleOCR inference models (docs/ocr-paddle-setup.md)
/python/models/paddleocr/

# 로컬 조사·디버그 임시 JSON (레이어·좌표계 테스트 등)
/tmp-*.json
/scripts/tmp-*.json

# GeoServer legend 샘플 (런타임 생성)
/geoserver_modules/data_dir/legendsamples/

# ggnr_start.bat(ggnr_v7 서비스 실행용 bat. 00_make_ggnr_starter.bat으로 생성 가능해 제외)
/ggnr_start.bat

# 로컬 조사·디버그 임시 JSON (레이어·좌표계 테스트 등)
/tmp-*.json
/scripts/tmp-*.json

# GeoServer legend 샘플 (런타임 생성)
/geoserver_modules/data_dir/legendsamples/

# ggnr_start.bat(ggnr_v7 서비스 실행용 bat. 00_make_ggnr_starter.bat으로 생성 가능해 제외)
/ggnr_start.bat
